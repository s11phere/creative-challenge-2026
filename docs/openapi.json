{
  "components": {
    "schemas": {
      "DependencyCheck": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "healthy": {
            "title": "Healthy",
            "type": "boolean"
          }
        },
        "required": [
          "healthy",
          "code"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Standard error response schema published in OpenAPI.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "trace_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "const": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LiveResponse",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "model": {
            "$ref": "#/components/schemas/DependencyCheck"
          },
          "postgresql": {
            "$ref": "#/components/schemas/DependencyCheck"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyCheck"
          }
        },
        "required": [
          "postgresql",
          "redis",
          "model"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Agent Knowledge Repository",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "Liveness probe — process event loop is responsive.",
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          }
        },
        "summary": "Live"
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Readiness probe — concurrent dependency check with stable machine codes.",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "One or more required dependencies are unavailable"
          }
        },
        "summary": "Ready"
      }
    }
  }
}
