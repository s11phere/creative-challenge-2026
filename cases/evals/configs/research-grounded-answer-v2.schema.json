{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-grounded-answer-v2.schema.json",
  "title": "Provisional Research reading grounded model output v2",
  "oneOf": [
    {"$ref": "#/$defs/deep_read"},
    {"$ref": "#/$defs/literature_review"},
    {"$ref": "#/$defs/refusal"}
  ],
  "$defs": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidence_id"}
    },
    "text_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_ids"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "text_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/text_item"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "deep_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_type",
        "mode",
        "research_question",
        "contributions",
        "method_explanation",
        "data_and_metrics",
        "results",
        "paper_limitations",
        "misconceptions",
        "follow_up_questions",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "research-grounded-answer-v2"},
        "result_type": {"const": "answer"},
        "mode": {"const": "research_deep_read"},
        "research_question": {"$ref": "#/$defs/text_item"},
        "contributions": {"$ref": "#/$defs/text_items"},
        "method_explanation": {"$ref": "#/$defs/text_items"},
        "data_and_metrics": {"$ref": "#/$defs/text_items"},
        "results": {"$ref": "#/$defs/text_items"},
        "paper_limitations": {"$ref": "#/$defs/text_items"},
        "misconceptions": {"$ref": "#/$defs/text_items"},
        "follow_up_questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "paper_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_label", "text", "evidence_ids"],
      "properties": {
        "paper_label": {"type": "string", "minLength": 1, "maxLength": 280},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "matrix_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_label", "text", "evidence_ids"],
      "properties": {
        "paper_label": {"type": "string", "minLength": 1, "maxLength": 280},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "observations", "synthesis", "evidence_ids", "comparability"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1, "maxLength": 200},
        "observations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/matrix_observation"}
        },
        "synthesis": {"type": "string", "minLength": 1, "maxLength": 3000},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "comparability": {
          "enum": ["comparable", "conditionally_comparable", "not_comparable"]
        }
      }
    },
    "thematic_section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "text", "evidence_ids"],
      "properties": {
        "theme": {"type": "string", "minLength": 1, "maxLength": 200},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "literature_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "result_type",
        "mode",
        "paper_briefs",
        "evidence_matrix",
        "thematic_review",
        "consensus",
        "apparent_differences",
        "genuine_conflicts",
        "evidence_gaps",
        "limitations"
      ],
      "properties": {
        "schema_version": {"const": "research-grounded-answer-v2"},
        "result_type": {"const": "answer"},
        "mode": {"const": "research_literature_review"},
        "paper_briefs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/paper_brief"}
        },
        "evidence_matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/matrix_row"}
        },
        "thematic_review": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/thematic_section"}
        },
        "consensus": {"$ref": "#/$defs/text_items"},
        "apparent_differences": {"$ref": "#/$defs/text_items"},
        "genuine_conflicts": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/text_item"}
        },
        "evidence_gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_type", "reason", "message", "limitations"],
      "properties": {
        "schema_version": {"const": "research-grounded-answer-v2"},
        "result_type": {"const": "refuse"},
        "reason": {"const": "insufficient_evidence"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    }
  }
}
