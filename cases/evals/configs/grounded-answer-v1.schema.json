{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grounded-answer-v1.schema.json",
  "title": "Provisional grounded answer model output v1",
  "oneOf": [
    {"$ref": "#/$defs/answer"},
    {"$ref": "#/$defs/refusal"},
    {"$ref": "#/$defs/conflict"}
  ],
  "$defs": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "evidence_ids"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        },
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_id"}
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_type", "answer", "claims", "limitations"],
      "properties": {
        "schema_version": {"const": "grounded-answer-v1"},
        "result_type": {"const": "answer"},
        "answer": {"type": "string", "minLength": 1, "maxLength": 16000},
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/claim"}
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_type", "reason", "message", "limitations"],
      "properties": {
        "schema_version": {"const": "grounded-answer-v1"},
        "result_type": {"const": "refuse"},
        "reason": {"const": "insufficient_evidence"},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result_type", "message", "evidence_ids", "limitations"],
      "properties": {
        "schema_version": {"const": "grounded-answer-v1"},
        "result_type": {"const": "conflict"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence_id"}
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    }
  }
}
