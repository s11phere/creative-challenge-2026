{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-qa-v0.schema.json",
  "title": "Knowledge QA evaluation case v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dataset_version",
    "split",
    "category",
    "space_id",
    "question",
    "expected_behavior",
    "answer_claims",
    "evidence",
    "forbidden_claims",
    "difficulty",
    "tags"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^qa-[0-9]{3}$"},
    "dataset_version": {"const": "v0"},
    "split": {"enum": ["development", "holdout"]},
    "category": {
      "enum": [
        "single_document_factual",
        "cross_document_synthesis",
        "version_or_conflict",
        "no_answer",
        "adversarial_document",
        "bilingual",
        "code_and_nl"
      ]
    },
    "space_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "expected_behavior": {"enum": ["answer", "refuse"]},
    "answer_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
          "properties": {
            "id": {"type": "string", "pattern": "^c[1-9][0-9]*$"},
            "text": {"type": "string", "minLength": 1},
            "acceptable_evidence_sets": {
              "type": "array",
              "items": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "forbidden_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reference_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "retrieval_expectations": {"type": "object"},
    "retrieval_context": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"expected_behavior": {"const": "answer"}}},
      "then": {
        "properties": {
          "answer_claims": {"minItems": 1},
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"expected_behavior": {"const": "refuse"}}},
      "then": {
        "properties": {
          "answer_claims": {"maxItems": 0},
          "evidence": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "page"],
          "properties": {
            "type": {"const": "pdf_page"},
            "page": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "start", "end"],
          "properties": {
            "type": {"const": "lines"},
            "start": {"type": "integer", "minimum": 1},
            "end": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "source_version", "locator", "quote", "excerpt_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_key": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"$ref": "#/$defs/locator"},
        "quote": {"type": "string", "minLength": 1},
        "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "supports_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c[1-9][0-9]*$"}
        }
      },
      "anyOf": [
        {"required": ["id"]},
        {"required": ["supports_claims"]}
      ]
    }
  }
}
