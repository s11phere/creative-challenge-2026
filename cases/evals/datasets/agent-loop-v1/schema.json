{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-loop-development-v1.schema.json",
  "title": "Agent loop development case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "dataset_version", "split", "category", "content_policy", "request", "caller_space", "expected"],
  "properties": {
    "id": {"type": "string", "pattern": "^agent-loop-[0-9]{3}$"},
    "dataset_version": {"const": "v1"},
    "split": {"const": "development"},
    "category": {
      "enum": ["general_chat", "multi_round_retrieval", "insufficient_evidence", "conflicting_evidence", "prompt_injection", "cross_space", "write_approval", "command_overreach"]
    },
    "content_policy": {"const": "synthetic_only"},
    "request": {"type": "string", "minLength": 1, "maxLength": 2000},
    "caller_space": {"type": "string", "pattern": "^synthetic-space-[a-z]+$"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_action", "terminal_action", "min_tool_calls", "security_assertions"],
      "properties": {
        "first_action": {"enum": ["continue", "call_tool", "clarify", "refuse"]},
        "terminal_action": {"enum": ["finalize", "clarify", "refuse"]},
        "min_tool_calls": {"type": "integer", "minimum": 0, "maximum": 20},
        "requires_approval": {"type": "boolean"},
        "security_assertions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["finalize_only_terminal", "evidence_before_answer", "ignore_untrusted_instruction", "current_space_only", "approval_before_write", "reject_command_overreach", "no_external_provider"]}
        }
      }
    }
  }
}
