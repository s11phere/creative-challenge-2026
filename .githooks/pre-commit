#!/usr/bin/env sh
# Pre-commit quality gate
#
# 提交前复现 CI 的快速质量门禁（Backend quality / OpenAPI / Frontend lint+typecheck），
# 与 .github/workflows/ci.yml 保持一致；完整 pytest、集成与 Compose smoke 仍由 CI 执行。
#
# 启用：git config core.hooksPath .githooks
# 跳过（不推荐）：git commit --no-verify
set -u

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
  exit 0
fi

# 与 CI paths-ignore 对齐：仅 docs/README/AGENTS 变更时无需检查。
ONLY_DOCS=1
for file in $STAGED; do
  case "$file" in
    docs/*|README.md|AGENTS.md) ;;
    *) ONLY_DOCS=0 ;;
  esac
done
if [ "$ONLY_DOCS" -eq 1 ]; then
  exit 0
fi

HAS_BACKEND=0
HAS_FRONTEND=0
for file in $STAGED; do
  case "$file" in
    *.py|pyproject.toml|uv.lock|alembic.ini|migrations/*|scripts/*|apps/api/*|apps/worker/*|packages/*)
      HAS_BACKEND=1
      ;;
    apps/web/*)
      HAS_FRONTEND=1
      ;;
  esac
done

FAILED=0
say() { printf '[pre-commit] %s\n' "$*"; }
fail() { FAILED=1; printf '[pre-commit] 未通过: %s\n' "$*"; }

if [ "$HAS_BACKEND" -eq 1 ]; then
  if command -v uv >/dev/null 2>&1; then
    say "ruff format --check ."
    uv run ruff format --check . || fail "ruff format 检查失败，先运行 uv run ruff format . 后重新 git add"
    say "ruff check ."
    uv run ruff check . || fail "ruff check 检查失败，先修复后重新 git add"
    say "mypy apps packages"
    uv run mypy apps packages || fail "mypy 类型检查失败"
    say "OpenAPI 一致性"
    uv run python scripts/export_openapi.py
    if ! git diff --exit-code -- docs/openapi.json; then
      fail "docs/openapi.json 已过期，运行 uv run python scripts/export_openapi.py && git add docs/openapi.json 后重试"
    fi
  else
    say "未找到 uv，跳过后端检查（CI 仍会执行）"
  fi
fi

if [ "$HAS_FRONTEND" -eq 1 ]; then
  # 与 CLAUDE.md 前端命令保持一致：corepack 固定 10.20.0，避免系统 pnpm
  # 版本与 packageManager 字段冲突导致版本检查失败。
  if command -v corepack >/dev/null 2>&1; then
    say "pnpm lint (apps/web)"
    corepack pnpm@10.20.0 --dir apps/web lint || fail "前端 lint 失败"
    say "pnpm typecheck (apps/web)"
    corepack pnpm@10.20.0 --dir apps/web typecheck || fail "前端 typecheck 失败"
    say "pnpm typecheck:e2e (apps/web)"
    corepack pnpm@10.20.0 --dir apps/web typecheck:e2e || fail "前端 e2e typecheck 失败"
  elif command -v pnpm >/dev/null 2>&1; then
    say "pnpm lint (apps/web)"
    pnpm --dir apps/web lint || fail "前端 lint 失败"
    say "pnpm typecheck (apps/web)"
    pnpm --dir apps/web typecheck || fail "前端 typecheck 失败"
    say "pnpm typecheck:e2e (apps/web)"
    pnpm --dir apps/web typecheck:e2e || fail "前端 e2e typecheck 失败"
  else
    say "未找到 corepack/pnpm，跳过前端检查（CI 仍会执行）"
  fi
fi

if [ "$FAILED" -eq 1 ]; then
  printf '[pre-commit] 门禁未通过，已阻止提交；修复后重新 git add 并提交。确需跳过时使用 git commit --no-verify 并说明理由。\n'
  exit 1
fi

say "门禁通过"
exit 0
