{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-loop-v1.schema.json",
  "title": "Agent loop decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action", "goal"],
  "properties": {
    "schema_version": {"const": "agent-loop-v1"},
    "action": {"enum": ["call_tool", "continue", "finalize", "clarify", "refuse"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "subquestions": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "arguments"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"},
        "arguments": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"not": {"pattern": "(^|_)(space|space_id|version_id|credential|secret)$"}}
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_complete", "evidence_sufficient", "has_conflict"],
      "properties": {
        "goal_complete": {"type": "boolean"},
        "evidence_sufficient": {"type": "boolean"},
        "has_conflict": {"type": "boolean"}
      }
    },
    "stop_reason": {
      "enum": ["goal_complete", "evidence_insufficient", "conflict", "user_clarification", "policy_refusal"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "call_tool"}}},
      "then": {"required": ["tool"], "not": {"required": ["completion", "stop_reason"]}}
    },
    {
      "if": {"properties": {"action": {"const": "finalize"}}},
      "then": {"required": ["completion", "stop_reason"], "not": {"required": ["tool"]}}
    },
    {
      "if": {"properties": {"action": {"enum": ["clarify", "refuse"]}}},
      "then": {"required": ["stop_reason"], "not": {"required": ["tool"]}}
    },
    {
      "if": {"properties": {"action": {"const": "continue"}}},
      "then": {"not": {"anyOf": [{"required": ["tool"]}, {"required": ["completion"]}, {"required": ["stop_reason"]}]}}
    }
  ]
}
