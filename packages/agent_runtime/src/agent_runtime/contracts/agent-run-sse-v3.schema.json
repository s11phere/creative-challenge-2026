{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-run-sse-v3.schema.json",
  "title": "Agent run SSE event v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "event_type", "payload"],
  "properties": {
    "schema_version": {"const": "agent-run-sse-v3"},
    "run_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {
      "enum": [
        "iteration_started", "tool_requested", "tool_started", "tool_output",
        "approval_required", "checkpoint_saved", "finalizing", "accepted", "completed",
        "clarifying", "refused", "failed", "cancelled", "timed_out"
      ]
    },
    "payload": {
      "type": "object",
      "maxProperties": 16,
      "properties": {
        "query_preview": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001F]*$",
          "description": "Bounded caller retrieval question; emitted only for knowledge_search."
        }
      },
      "propertyNames": {
        "not": {"pattern": "(?i)(prompt|answer|secret|credential|raw|stdout|stderr|document_body)"}
      }
    }
  }
}
