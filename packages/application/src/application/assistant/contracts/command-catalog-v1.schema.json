{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistant-command-catalog-v1.schema.json",
  "title": "Assistant command catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commands"],
  "properties": {
    "schema_version": {"const": "assistant-command-catalog-v1"},
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "aliases", "kind", "description", "argument_hint", "input_mode"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "aliases": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          },
          "kind": {"enum": ["base", "skill"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 280},
          "argument_hint": {"type": "string", "maxLength": 160},
          "input_mode": {"enum": ["none", "question", "document", "sources"]}
        }
      }
    }
  }
}

