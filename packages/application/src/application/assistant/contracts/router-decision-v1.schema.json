{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assistant-router-decision-v1.schema.json",
  "title": "Assistant router decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action"],
  "properties": {
    "schema_version": {"const": "assistant-router-decision-v1"},
    "action": {"enum": ["respond", "clarify", "invoke_skill"]},
    "assistant_message": {"type": "string", "minLength": 1, "maxLength": 12000},
    "skill_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "arguments": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "not": {
          "pattern": "(^|_)(id|ids|space|space_id|version|version_id)$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "respond"}}},
      "then": {
        "required": ["assistant_message"],
        "not": {"anyOf": [{"required": ["skill_name"]}, {"required": ["arguments"]}]}
      }
    },
    {
      "if": {"properties": {"action": {"const": "clarify"}}},
      "then": {
        "required": ["assistant_message"],
        "not": {"anyOf": [{"required": ["skill_name"]}, {"required": ["arguments"]}]}
      }
    },
    {
      "if": {"properties": {"action": {"const": "invoke_skill"}}},
      "then": {
        "required": ["skill_name", "arguments"],
        "not": {"required": ["assistant_message"]}
      }
    }
  ]
}

