{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "phase", "citations", "next_action"],
  "properties": {
    "schema_version": {"const": "exam-preparation-workflow-output-v1"},
    "status": {"enum": ["in_progress", "waiting_user_input", "waiting_approval", "completed", "refused"]},
    "phase": {"enum": ["map_course", "broad_quiz", "adaptive_quiz", "diagnose", "review_plan", "card_preview", "mock_exam", "mock_review"]},
    "course_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["chapter", "topics", "weight_basis", "citation_ids"], "properties": {"chapter": {"type": "string"}, "topics": {"type": "array", "items": {"type": "string"}}, "weight_basis": {"enum": ["explicit_source", "historical_inference", "unknown"]}, "citation_ids": {"type": "array", "items": {"type": "string"}}}}},
    "diagnostic_quiz": {"$ref": "#/$defs/questionPaper"},
    "diagnostic_review": {"$ref": "#/$defs/review"},
    "diagnostic_result": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["chapter", "mastery", "question_ids", "citation_ids"], "properties": {"chapter": {"type": "string"}, "mastery": {"enum": ["strong", "needs_review", "uncertain", "not_tested"]}, "question_ids": {"type": "array", "items": {"type": "string"}}, "recommended_action": {"type": "string"}, "citation_ids": {"type": "array", "items": {"type": "string"}}}}},
    "review_plan": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["goal", "tasks", "completion_criteria", "citation_ids"], "properties": {"goal": {"type": "string"}, "tasks": {"type": "array", "items": {"type": "string"}}, "completion_criteria": {"type": "string"}, "citation_ids": {"type": "array", "items": {"type": "string"}}}}},
    "review_card_preview": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["front", "back", "citation_ids"], "properties": {"front": {"type": "string"}, "back": {"type": "string"}, "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "mock_exam_paper": {"$ref": "#/$defs/questionPaper"},
    "mock_exam_review": {"$ref": "#/$defs/review"},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "next_action": {"enum": ["submit_broad_answers", "complete_adaptive_quiz", "approve_cards", "start_mock_exam", "submit_mock_exam", "reveal_mock_exam_answers", "complete"]},
    "refusal": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
  },
  "$defs": {
    "questionPaper": {"type": "object", "additionalProperties": false, "required": ["paper_id", "questions"], "properties": {"paper_id": {"type": "string"}, "suggested_minutes": {"type": "integer", "minimum": 1}, "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["question_id", "kind", "prompt", "options", "chapter", "difficulty", "points", "citation_ids"], "properties": {"question_id": {"type": "string"}, "kind": {"enum": ["single_choice", "multiple_choice"]}, "prompt": {"type": "string"}, "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["option_id", "text"], "properties": {"option_id": {"type": "string"}, "text": {"type": "string"}}}}, "chapter": {"type": "string"}, "difficulty": {"enum": ["easy", "medium", "hard"]}, "points": {"type": "number", "exclusiveMinimum": 0}, "citation_ids": {"type": "array", "items": {"type": "string"}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["paper_id", "items"], "properties": {"paper_id": {"type": "string"}, "score": {"type": "number", "minimum": 0}, "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["question_id", "correct_options", "explanation", "citation_ids"], "properties": {"question_id": {"type": "string"}, "correct_options": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "explanation": {"type": "string"}, "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}}},
    "citation": {"type": "object", "additionalProperties": false, "required": ["citation_id", "evidence_id"], "properties": {"citation_id": {"type": "string"}, "evidence_id": {"type": "string", "format": "uuid"}}}
  }
}
