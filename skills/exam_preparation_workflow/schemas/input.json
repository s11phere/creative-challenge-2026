{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["question"],
  "properties": {
    "question": {"type": "string", "minLength": 1, "maxLength": 4000},
    "exam_kind": {"enum": ["midterm", "final", "custom"]},
    "exam_date": {"type": "string", "format": "date-time"},
    "target_minutes": {"type": "integer", "minimum": 15, "maximum": 360},
    "resource_reference": {"type": "string", "minLength": 1, "maxLength": 2000},
    "interaction_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "paper_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "submission_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "capability": {"enum": ["diagnose", "adaptive_check", "review_plan", "study_guide", "review_cards", "mock_exam", "review"]},
    "action": {"enum": ["submit_answers", "reveal_answers"]},
    "answers": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/answer"}}
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "selected_options": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 20}},
        "response_text": {"type": "string", "minLength": 1, "maxLength": 12000},
        "confidence": {"enum": ["low", "medium", "high"]}
      },
      "oneOf": [
        {"required": ["selected_options"]},
        {"required": ["response_text"]}
      ]
    }
  }
}
