{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "outcome", "qa_run_id", "publication"],
  "properties": {
    "status": {"enum": ["completed", "refused"]},
    "outcome": {"enum": ["answer", "refuse", "conflict"]},
    "qa_run_id": {"type": "string", "format": "uuid"},
    "publication": {"const": "grounded_qa"}
  }
}
