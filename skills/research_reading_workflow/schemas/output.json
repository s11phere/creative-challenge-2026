{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "citations", "next_action"],
  "properties": {
    "schema_version": {"const": "research-reading-workflow-output-v2"},
    "status": {"enum": ["waiting_user_input", "completed", "refused"]},
    "mode": {"enum": ["deep_read", "literature_review"]},
    "candidate_labels": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 280}},
    "deep_read": {"$ref": "#/$defs/deepRead"},
    "paper_briefs": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/evidenceItem"}},
    "evidence_matrix": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "thematic_review": {"$ref": "#/$defs/evidenceItem"},
    "consensus": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "apparent_differences": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "genuine_conflicts": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "next_action": {"enum": ["confirm_sources", "provide_exact_document", "save_markdown", "complete"]},
    "refusal": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}
  },
  "$defs": {
    "evidenceItem": {"type": "object", "additionalProperties": false, "required": ["text", "citation_ids"], "properties": {"text": {"type": "string"}, "citation_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "comparability": {"enum": ["comparable", "conditionally_comparable", "not_comparable"]}}},
    "deepRead": {"type": "object", "additionalProperties": false, "required": ["research_question", "contributions", "method_explanation", "data_and_metrics", "results", "limitations", "misconceptions", "follow_up_questions"], "properties": {"research_question": {"$ref": "#/$defs/evidenceItem"}, "contributions": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "method_explanation": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "data_and_metrics": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "results": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "misconceptions": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}}, "follow_up_questions": {"type": "array", "items": {"type": "string"}}}},
    "citation": {"type": "object", "additionalProperties": false, "required": ["citation_id", "evidence_id"], "properties": {"citation_id": {"type": "string"}, "evidence_id": {"type": "string", "format": "uuid"}}}
  }
}
