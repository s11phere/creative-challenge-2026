{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["question"],
  "properties": {
    "question": {"type": "string", "minLength": 1, "maxLength": 12000},
    "mode": {"enum": ["auto", "deep_read", "literature_review"]},
    "topic": {"type": "string", "minLength": 1, "maxLength": 1000},
    "document_references": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 280}},
    "focus": {"type": "string", "maxLength": 1000},
    "audience_level": {"const": "undergraduate", "default": "undergraduate"}
  }
}
