{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "run_id", "conversation_id", "versions", "usage", "result"],
  "properties": {
    "schema_version": {"const": "knowledge-qa-skill-output-v1"},
    "status": {"enum": ["completed", "refused"]},
    "run_id": {"type": "string", "format": "uuid"},
    "conversation_id": {"type": "string", "format": "uuid"},
    "versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "model_calls"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "claims", "citations", "limitations"],
          "properties": {
            "type": {"const": "answer"},
            "text": {"type": "string", "minLength": 1},
            "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "citations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "code", "reason", "message"],
          "properties": {
            "type": {"const": "refusal"},
            "code": {"type": "string"},
            "reason": {"type": "string"},
            "message": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "evidence_ids", "message"],
          "properties": {
            "type": {"const": "conflict"},
            "evidence_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "format": "uuid"}},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
