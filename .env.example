# =============================================================================
# Agent Knowledge Repository — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your local values.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000
# Website production integration. Keep false for the standalone local demo.
# In production generate a high-entropy value and inject it through a secret
# manager; never put it in a browser bundle or commit it to Git.
# PUBLIC_MODE=true requires SERVICE_AUTH_REQUIRED=true plus a non-empty
# INTERNAL_SERVICE_TOKEN, and refuses MODEL_ALLOW_EXTERNAL=true unless
# PUBLIC_MODE_ALLOW_EXTERNAL_MODEL=true records an explicit data-usage review.
SERVICE_AUTH_REQUIRED=false
PUBLIC_MODE=false
PUBLIC_MODE_ALLOW_EXTERNAL_MODEL=false
# INTERNAL_SERVICE_TOKEN=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_knowledge
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Worker ---
WORKER_PROCESSES=1
WORKER_THREADS=4
WORKER_SHUTDOWN_TIMEOUT_MS=30000
DIAGNOSTIC_TASK_TIMEOUT_MS=10000
DIAGNOSTIC_TASK_MAX_RETRIES=3
DIAGNOSTIC_TASK_MIN_BACKOFF_MS=1000

# --- Model Provider (fake is default, no credentials needed) ---
# Leave commented to use the deterministic fake.
# Uncomment and configure one provider path. `text-embeddings-inference`
# serves embeddings/reranking only; it does not provide `fast_chat`.
MODEL_PROVIDER=fake
# For external Chat with the pinned local TEI embedding profile, use this
# capability split and enable the `embedding` Compose profile:
# MODEL_PROVIDER=openai-compatible
# MODEL_ALLOW_EXTERNAL=true
# EMBEDDING_PROVIDER=text-embeddings-inference
# FAST_CHAT_ENDPOINT=https://api.example.com/v1
# FAST_CHAT_API_KEY=
# FAST_CHAT_MODEL=chat-model-name
# EMBEDDING_ENDPOINT=http://tei:80
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
# EMBEDDING_PROTOCOL=tei
# EMBEDDING_QUERY_INSTRUCTION_VERSION=qwen3-knowledge-qa-v1
# EMBEDDING_DOCUMENT_INSTRUCTION_VERSION=qwen3-knowledge-qa-v1
# EMBEDDING_NORMALIZATION=l2
# EMBEDDING_BATCH_SIZE=8
# Complete GPU retrieval: start the `reranker` Compose profile and inherit the primary provider.
# RERANKER_PROVIDER=inherit
# RERANKER_ENDPOINT=http://tei-reranker:80
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_BATCH_SIZE=4
# Use a fake auxiliary reranker only when validating the Agent flow without a reranker service.
# RERANKER_PROVIDER=fake
# Use http://localhost:8080 instead when API/Worker run on the host.
# Set true only with an explicitly reviewed external Chat endpoint.
MODEL_ALLOW_EXTERNAL=false
# Keep false unless the user explicitly agrees that selected workspace file contents may reach
# the configured Chat provider. `start-local.ps1 -AllowExternalWorkspaceTools` enables it for one run.
AGENT_WORKSPACE_MODEL_VISIBILITY_CONSENT=false
MODEL_TIMEOUT_SECONDS=15
FAST_CHAT_TIMEOUT_SECONDS=120
FAST_CHAT_REASONING_ENABLED=false
FAST_CHAT_PROMPT_CACHING=true
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.1

# --- Embedding configuration ---
# These apply when EMBEDDING_ENDPOINT points to a running TEI instance.
# EMBEDDING_PORT is used by Docker Compose's tei service (not the app).
# TEI_VOLUME_NAME optionally points the Compose `tei` service at an existing
# prewarmed Docker volume; the default is `deploy_teidata`.
# TEI_VOLUME_NAME=creative-challenge-qwen3-embedding-0.6b
# EMBEDDING_PROTOCOL=tei
# EMBEDDING_QUERY_INSTRUCTION_VERSION=none-v1
#   none-v1            = no instruction prefix (bare query text)
#   qwen3-knowledge-qa-v1 = "Instruct: Given a question, retrieve ...\nQuery: "
#   qwen3-web-search-v1   = "Instruct: Given a web search query, retrieve ...\nQuery: "
# EMBEDDING_DOCUMENT_INSTRUCTION_VERSION=none-v1
#   none-v1            = no instruction prefix (bare chunk text)
#   qwen3-knowledge-qa-v1 = "Instruct: ...\nDocument: "  (asymmetric with Query)
#   qwen3-web-search-v1   = "Instruct: ...\nDocument: "  (asymmetric with Query)
# EMBEDDING_NORMALIZATION=none
# EMBEDDING_PRECISION=float32
# EMBEDDING_BATCH_SIZE=8

# --- Reranker configuration ---
# Apply when RERANKER_ENDPOINT points to a running TEI reranker instance.
# For a retrieval-only process without `fast_chat`, MODEL_PROVIDER may be
# text-embeddings-inference. Web QA and knowledge_agent instead use the capability split above.
# RERANKER_ENDPOINT=http://tei-reranker:80
# RERANKER_MODEL=bge-reranker-v2-m3
# RERANKER_BATCH_SIZE=4
# Use http://localhost:8081 instead when API/Worker run on the host.
# RERANKER_API_KEY=
# RERANKER_PORT is used by Docker Compose's tei-reranker service (not the app).
# RERANKER_VOLUME_NAME=deploy_rerankerdata

# --- Retrieval ---
RETRIEVAL_TIMEOUT_SECONDS=15
SKILL_ROOT_PATH=./skills
# KNOWLEDGE_AGENT_SKILL_VERSION pins new Runs to the single current package.
KNOWLEDGE_AGENT_SKILL_VERSION=1.0.0
# Conversation workspaces are local folders below this root. API and Worker must use
# the same path; Compose maps AGENT_WORKSPACE_HOST_PATH to this container path.
AGENT_WORKSPACE_ROOT_PATH=./data/workspaces
AGENT_WORKSPACE_HOST_PATH=../data/workspaces
# Comma-separated executable aliases exposed to an approved local workspace command Tool.
AGENT_WORKSPACE_COMMAND_ALIASES=python,git,uv,node,pnpm,npm
# Development only. Production always suppresses internal diagnostics.
RETRIEVAL_DEBUG_DIAGNOSTICS=false
# Full QA prompts/responses and Tool payloads. Development only; remains disabled by default.
QA_DEBUG_TRACE_ENABLED=false
QA_DEBUG_TRACE_MAX_BYTES=10000000
# Compose host path; containers always write to /data/qa-debug.
QA_DEBUG_TRACE_HOST_PATH=../tmp/qa-debug

# --- OpenTelemetry (optional) ---
# OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_TIMEOUT_SECONDS=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
