# =============================================================================
# Agent Knowledge Repository — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your local values.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_knowledge
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Worker ---
WORKER_PROCESSES=1
WORKER_THREADS=4
WORKER_SHUTDOWN_TIMEOUT_MS=30000
DIAGNOSTIC_TASK_TIMEOUT_MS=10000
DIAGNOSTIC_TASK_MAX_RETRIES=3
DIAGNOSTIC_TASK_MIN_BACKOFF_MS=1000

# --- Model Provider (fake is default, no credentials needed) ---
# Leave commented to use the deterministic fake.
# Uncomment and configure one provider path.
MODEL_PROVIDER=fake
# MODEL_PROVIDER=openai-compatible
# MODEL_ENDPOINT=http://localhost:11434/v1
# MODEL_API_KEY=
# FAST_CHAT_ENDPOINT=http://localhost:11434/v1
# FAST_CHAT_MODEL=local-chat-model
# MODEL_PROVIDER=text-embeddings-inference
# EMBEDDING_ENDPOINT=http://tei:80
# EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
# EMBEDDING_MODEL_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65
# EMBEDDING_PROTOCOL=tei
# Use http://localhost:8080 instead when API/Worker run on the host.
MODEL_ALLOW_EXTERNAL=false
MODEL_TIMEOUT_SECONDS=15
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=0.1

# --- Retrieval ---
RETRIEVAL_TIMEOUT_SECONDS=15
# Development only. Production always suppresses internal diagnostics.
RETRIEVAL_DEBUG_DIAGNOSTICS=false

# --- Optional local Reranker ---
# Use http://reranker:80 for Compose API/Worker, or localhost for host processes.
# RERANKER_ENDPOINT=http://localhost:8081
# RERANKER_MODEL=BAAI/bge-reranker-base@2cfc18c9415c912f9d8155881c133215df768a70

# --- OpenTelemetry (optional) ---
# OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_TIMEOUT_SECONDS=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
