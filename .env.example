# =============================================================================
# Agent Knowledge Repository — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your local values.
# Never commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_knowledge
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Model Provider (fake is default, no credentials needed) ---
# Leave commented to use the deterministic fake.
# Uncomment and configure to enable an OpenAI-compatible endpoint.
# MODEL_PROVIDER=openai-compatible
# MODEL_ENDPOINT=http://localhost:11434/v1
# MODEL_API_KEY=
# FAST_CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# --- OpenTelemetry (optional) ---
# OTLP_ENDPOINT=http://localhost:4318

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
