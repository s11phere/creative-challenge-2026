FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS builder

RUN pip install --no-cache-dir uv==0.11.1

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/worker/ apps/worker/
COPY skills/ skills/
COPY alembic.ini ./
COPY migrations/ migrations/
COPY cases/evals/configs/grounded-answer-v1.schema.json cases/evals/configs/grounded-answer-v1.schema.json
COPY cases/evals/configs/research-grounded-answer-v2.schema.json cases/evals/configs/research-grounded-answer-v2.schema.json
COPY cases/evals/prompts/grounded-qa-v1-provisional.txt cases/evals/prompts/grounded-qa-v1-provisional.txt
COPY cases/evals/prompts/grounded-qa-v2-provisional.txt cases/evals/prompts/grounded-qa-v2-provisional.txt

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package api

FROM public.ecr.aws/docker/library/python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10001 app && \
    useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app

WORKDIR /app

COPY --from=builder /app /app

# `/app/data/blobs` is a Compose volume mount point. Creating it in the image
# makes Docker seed a fresh named volume with this directory's ownership;
# otherwise the volume is created `root:root` and the non-root process cannot
# write uploads (HTTP 500 / PermissionError).
RUN mkdir -p /app/data/blobs && chown -R app:app /app

ENV PATH="/app/.venv/bin:$PATH"

USER app

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
