FROM public.ecr.aws/docker/library/node:24.11.0-bookworm-slim@sha256:76d0ed0ed93bed4f4376211e9d8fddac4d8b3fbdb54cc45955696001a3c91152 AS builder

RUN corepack enable && corepack prepare pnpm@10.20.0 --activate

WORKDIR /app
COPY apps/web/package.json apps/web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY apps/web/ .
ARG VITE_ASSISTANT_DEFAULT_API_MODE=v2
ARG VITE_ASSISTANT_V1_COMPATIBILITY_UNTIL=2026-09-30T23:59:59Z
ENV VITE_ASSISTANT_DEFAULT_API_MODE=$VITE_ASSISTANT_DEFAULT_API_MODE
ENV VITE_ASSISTANT_V1_COMPATIBILITY_UNTIL=$VITE_ASSISTANT_V1_COMPATIBILITY_UNTIL
RUN pnpm build

FROM public.ecr.aws/docker/library/nginx:alpine@sha256:7068961d45b07b2af510ac002e9daa63a1d3eba2111202d6768798690800fffd
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
